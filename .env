# ==============================================================================
# CẤU HÌNH HỆ THỐNG CẢNH BÁO VA CHẠM SỚM ADAS (JETSON NANO & PC)
# Chỉ cần sửa các giá trị bên dưới mà không cần chỉnh sửa code Python.
# ==============================================================================

# Nguồn video đầu vào: Tên file video trong thư mục gốc, đường dẫn file, hoặc "0" cho Webcam/CSI Camera
ADAS_VIDEO_SOURCE=NO20250604-063730-010007F.MP4

# Đường dẫn trọng số YOLO: "auto" sẽ tự động ưu tiên best.engine (TensorRT FP16) nếu có, ngược lại dùng best.pt
ADAS_WEIGHTS=auto

# Kích thước ảnh suy luận (pixels) - 320 tối ưu tốc độ thời gian thực trên Jetson Nano
ADAS_IMGSZ=320

# Thiết bị tính toán: "auto" (tự nhận diện GPU CUDA "0" hoặc "cpu"), hoặc chỉ định rõ "0" / "cpu"
ADAS_DEVICE=auto

# Số lượng frame tối đa khi chạy kiểm thử nhanh với run.py
ADAS_MAX_FRAMES=100

# Số lượng frame khởi động (warm-up) bỏ qua khi tính trung bình FPS & Latency
ADAS_WARMUP_FRAMES=5

# Ngưỡng độ tự tin (Confidence Threshold) và ngưỡng chồng lấp (NMS IoU Threshold) của YOLOv8
ADAS_CONF_THRES=0.25
ADAS_IOU_THRES=0.45

# Cấu hình cảnh báo âm thanh (Đặt false khi chạy headless/VNC trên Jetson Nano để tránh lỗi thiết bị âm thanh)
ADAS_AUDIO_ENABLED=false
ADAS_AUDIO_COOLDOWN=5.0

